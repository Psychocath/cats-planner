# The only one you must set: the password you type to open the planner
APP_PASSWORD=

# Optional. Added automatically when the Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
# Optional. If unset, the app makes its own push keys and keeps them in its private data file
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional. If set, the cron route requires it (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional. If unset, login cookies are signed with a key derived from APP_PASSWORD
SESSION_SECRET=

# Free Gemini API key from aistudio.google.com/apikey, for the "Tell the planner" box
GEMINI_API_KEY=
# Optional: pin a Gemini model, e.g. gemini-2.5-flash
GEMINI_MODEL=

# Optional. Supabase's Vercel integration adds this. When set, the planner keeps its data in Postgres
# (one row per task, event, routine and slot) and copies the Blob data file across once on first start.
POSTGRES_URL=
# Optional. Set to "blob" to go back to the Blob data file
PLANNER_STORE=
